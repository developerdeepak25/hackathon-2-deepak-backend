MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/policyhawk
PORT=4000
# `*` allows every browser origin. Or list origins, comma-separated:
# FRONTEND_URL=http://localhost:3000,https://your-frontend.example
FRONTEND_URL=*

# Required to trigger policy checks manually via POST /api/companies/:slug/check
JOB_SECRET=replace-with-a-long-random-secret

# Optional: summarizes detected policy changes. Without a key, changes use the fallback summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used when the primary model is overloaded, down, or times out.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Unused. Simulation is allowed in production and does not store a change.
ALLOW_CHANGE_SIMULATION=true
